{
  "files.watcherExclude": {
    "**/target": true,
    "**/.git": true,
  },
  "rust-analyzer.cargo.features": [
    "smol",
    "blocking"
  ],
  "rust-analyzer.linkedProjects": [
    "./Cargo.toml"
  ],
  "rust-analyzer.runnables.extraArgs": [
    "--features=smol,blocking",
  ],
  "rust-analyzer.rustfmt.overrideCommand": [
    "rustfmt",
    "+nightly",
    "--edition=2024"
  ],
  "rust-analyzer.rustfmt.rangeFormatting.enable": true,
  "rust-analyzer.cargo.extraEnv": {
    "RUST_LOG": "debug,chitchat::failure_detector=info,smolscale=warn,rustls=warn"
  },
  "rust-analyzer.runnables.extraEnv": {
    "RUST_LOG": "debug,chitchat::failure_detector=info,smolscale=warn,rustls=warn"
  },
  "debug.javascript.defaultRuntimeExecutable": {
    "pwa-node": "/home/ivan/.local/share/mise/shims/node"
  },
  "go.goroot": "/home/ivan/.local/share/mise/installs/go/1.25.4",
  "go.alternateTools": {
    "go": "/home/ivan/.local/share/mise/shims/go"
  }
}
